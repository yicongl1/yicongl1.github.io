&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#66d9ef"&gt;if&lt;/span&gt; (height[left] &lt;span style="color:#f92672"&gt;&amp;lt;&lt;/span&gt; height[right]) &lt;span style="color:#f92672"&gt;++&lt;/span&gt;left;
